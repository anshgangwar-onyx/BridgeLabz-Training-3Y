function getBugs() {
    return new Promise((resolve, reject) => {
        setTimeout(() => {
            let failed = Math.random() < 0.2;
            if (failed) {
                reject("Failed to fetch bugs");
            } else {
                resolve(["UI glitch", "API timeout", "Login failure"]);
            }
        }, 1000);
    });
}

getBugs()
    .then((bugs) => {
        console.table(bugs);
    })
    .catch((error) => {
        console.log("Error:", error);
    });
    