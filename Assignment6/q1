function boilWater() {
    return new Promise((resolve, reject) => {
        setTimeout(() => {
            if (Math.random() < 0.1) {
                reject("Boiling failed");
            } else {
                console.log("Water boiled");
                resolve();
            }
        }, 1500);
    });
}

function brewCoffee() {
    return new Promise((resolve, reject) => {
        setTimeout(() => {
            if (Math.random() < 0.1) {
                reject("Brewing failed");
            } else {
                console.log("Coffee brewed");
                resolve();
            }
        }, 1500);
    });
}

function pourCup() {
    return new Promise((resolve, reject) => {
        setTimeout(() => {
            if (Math.random() < 0.1) {
                reject("Pouring failed");
            } else {
                console.log("Coffee poured");
                resolve();
            }
        }, 1500);
    });
}

boilWater()
    .then(() => brewCoffee())
    .then(() => pourCup())
    .then(() => console.log("Coffee ready for the team!"))
    .catch((error) => console.log("Error:", error));